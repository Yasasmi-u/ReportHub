# Repo-level gitignore for ReportHub

# Node modules
node_modules/

# Mini project node_modules
Mini/node_modules/
Mini/frontend/node_modules/
Mini/backend/node_modules/

# Ignore per-user npm config in Mini
Mini/.npmrc

# Environment files
.env
*.env
Mini/.env
Mini/backend/.env

# Build / cache
dist/
build/
.cache/
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# Editor/OS files
.DS_Store
.vscode/
.idea/

# Keep lockfiles
!package-lock.json
!yarn.lock
!pnpm-lock.yaml
